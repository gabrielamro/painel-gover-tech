{
  "name": "painel-gover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "dev:react": "vite --config vite.config.ts",
    "build:react": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:react": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "start": "node server.js",
    "check": "node --check app.js && node --check server.js && node --check domain.js",
    "test": "node tests/domain.test.mjs && node tests/sprint-domain-service.test.mjs",
    "migrate:local": "node scripts/migrate-local-storage.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
